# QED website configuration. Copy to `.env` for local development; in production pass these
# as environment variables (docker compose `env_file:`), never bake them into the image.
# Real environment variables override values in .env.

# --- Server -------------------------------------------------------------------------------
# Port the Node server listens on (the Docker image exposes 3000).
PORT=3000
# Public origin of the site in production, used for canonical/OG URLs and the Google OAuth
# callback. Ignored by `npm run dev`, which always uses the request's origin (http://localhost:3000).
SITE_URL=
# Languages offered in the language switcher, in order. Must have a file in /locales.
SUPPORTED_LANGUAGES=es,en

# --- Database -----------------------------------------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/qed
# Seconds without a database connection before the process exits so Docker restarts it.
# Defaults to 60 in production and 0 (disabled) otherwise.
DB_WATCHDOG_SECONDS=60

# --- Admin login (Google OAuth) ------------------------------------------------------------
# Google Cloud console → Credentials → OAuth client (Web application).
# Authorized redirect URIs: <SITE_URL>/auth/google/callback (and http://localhost:3000/auth/google/callback for dev).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# This account can always log in and can't be removed from the admin list.
QED_EMAIL=qed.uam@gmail.com
# Development only: enables /auth/dev?email=<admin email> to log in without Google.
# Ignored when NODE_ENV=production.
AUTH_DEV_LOGIN=0

# --- Contact form (Resend) -----------------------------------------------------------------
# https://resend.com/api-keys. Without a key, messages are only printed to the server log.
RESEND_API_KEY=
# Sender; must use a domain verified in Resend.
CONTACT_FROM_EMAIL=QED UAM <web@qed.mat.uam.es>
# Where contact messages go. Defaults to QED_EMAIL.
CONTACT_TO_EMAIL=qed.uam@gmail.com
