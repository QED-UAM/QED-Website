---
import Base from "../../layouts/Base.astro";
import Icon from "../../components/Icon.astro";
import Untranslated from "../../components/Untranslated.astro";
import { usePage } from "../../lib/page";
import { getProfile } from "../../lib/content";
import { boardRoleKey } from "../../lib/format";
import { DEFAULT_AVATAR } from "../../lib/config";
import type { IconName } from "../../components/icons";

const { locale, t, href, param } = usePage(Astro);
const profile = await getProfile(param("url"), locale);
if (!profile) return Astro.rewrite("/404");

const socialLinks: { icon: IconName; label: string; href: (value: string) => string }[] = [
    { icon: "linkedin", label: "LinkedIn", href: (v) => `https://linkedin.com/in/${v}` },
    { icon: "instagram", label: "Instagram", href: (v) => `https://instagram.com/${v}` },
    { icon: "x", label: "X", href: (v) => `https://twitter.com/${v}` },
    { icon: "email", label: "Email", href: (v) => `mailto:${v}` }
];
const socials = socialLinks.filter((social) => profile.socialMedia[social.icon]);
const history = [...profile.directiveBoard].sort((a, b) => b.year.localeCompare(a.year));
---

<Base title={profile.name || t("profile.url")} image={profile.photo} type="profile">
    <div class="mx-auto max-w-3xl px-5 pt-6 sm:px-8 sm:pt-12">
        <header class="flex flex-col items-center gap-6 text-center sm:flex-row sm:items-center sm:text-left">
            <img
                src={profile.photo}
                alt=""
                width="128"
                height="128"
                class:list={[
                    "size-28 shrink-0 rounded-full border border-grid object-cover sm:size-32",
                    profile.currentRole && "ring-4 ring-marker ring-offset-4 ring-offset-paper"
                ]}
                onerror={`this.onerror=null;this.src='${DEFAULT_AVATAR}';`}
            />
            <div>
                <h1 class="font-serif text-4xl font-bold text-ink sm:text-5xl">{profile.name}</h1>
                {
                    socials.length > 0 && (
                        <ul
                            class="mt-3 flex justify-center gap-4 sm:justify-start"
                            aria-label={t("profile.socialMedia", { name: profile.name })}>
                            {socials.map((social) => (
                                <li>
                                    <a
                                        href={social.href(profile.socialMedia[social.icon])}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        class="text-graphite/70 transition-colors hover:text-ink">
                                        <Icon name={social.icon} class="size-6" label={social.label} />
                                    </a>
                                </li>
                            ))}
                        </ul>
                    )
                }
                {
                    profile.currentRole && (
                        <p class="mt-4 inline-flex items-center gap-1.5 rounded-md border-2 border-ink px-3 py-1 text-sm font-semibold text-ink">
                            <Icon name="badge" class="size-5" />
                            {t(`profile.role.${profile.currentRole}`)}
                        </p>
                    )
                }
            </div>
        </header>

        {
            profile.aboutHtml.trim() && (
                <div
                    class="article-body prose prose-custom dark:prose-invert mt-10 max-w-none break-words"
                    set:html={profile.aboutHtml}
                />
            )
        }

        {
            profile.collaborations.length > 0 && (
                <section class="mt-14" aria-labelledby="collaborations">
                    <h2 id="collaborations" class="border-b border-grid pb-3 font-serif text-2xl font-bold">
                        {t("profile.collaboratedArticles")}
                    </h2>
                    <ul class="divide-y divide-grid">
                        {profile.collaborations.map((post) => (
                            <li class="group py-5">
                                <a href={href("article", { url: post.url })} class="block">
                                    <span class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
                                        <span class="font-serif text-xl font-bold decoration-marker decoration-2 underline-offset-4 group-hover:underline">
                                            <Untranslated missing={post.missing} message={t("magazine.post.noTranslation")}>
                                                {post.title}
                                                {post.showMagazineTitle && post.magazineTitle && (
                                                    <span class="font-sans text-sm font-normal text-muted"> ({post.magazineTitle})</span>
                                                )}
                                            </Untranslated>
                                        </span>
                                        <span class="text-sm font-medium text-muted">{t(`roles.${post.role}`)}</span>
                                    </span>
                                    {post.description && <span class="mt-1 block text-graphite/85">{post.description}</span>}
                                </a>
                            </li>
                        ))}
                    </ul>
                </section>
            )
        }

        {
            history.length > 0 && (
                <section class="mt-14" aria-labelledby="board-history">
                    <h2 id="board-history" class="border-b border-grid pb-3 font-serif text-2xl font-bold">
                        {t("profile.directiveBoardHistory")}
                    </h2>
                    <ol class="mt-6 border-l-2 border-grid pl-6">
                        {history.map((entry) => (
                            <li class="relative pb-5 last:pb-0">
                                <span class="absolute top-1.5 -left-[1.95rem] size-3 rounded-full border-2 border-paper bg-marker" aria-hidden="true" />
                                <span class="block text-sm font-semibold text-muted tabular-nums">{entry.year}</span>
                                <span class="block">{t(boardRoleKey(entry.role))}</span>
                            </li>
                        ))}
                    </ol>
                </section>
            )
        }
    </div>
</Base>
