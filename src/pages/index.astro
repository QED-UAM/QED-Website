---
import Base from "../layouts/Base.astro";
import Hero from "../components/Hero.astro";
import MagazineCover from "../components/MagazineCover.astro";
import Untranslated from "../components/Untranslated.astro";
import { usePage } from "../lib/page";
import { getNews, latestMagazine } from "../lib/content";

const { locale, t, href } = usePage(Astro);
const [news, latest] = await Promise.all([
    getNews(locale).catch(() => null),
    latestMagazine(locale).catch(() => null)
]);

const activities = [
    {
        title: t("index.tournamentsTitle"),
        text: t("index.tournamentsDesc"),
        photo: "https://live.staticflickr.com/65535/54642647198_2ca4ebd585_b.jpg"
    },
    {
        title: t("index.gymkhanaTitle"),
        text: t("index.gymkhanaDesc"),
        photo: "https://live.staticflickr.com/65535/54642651699_c130a681ec_b.jpg"
    },
    {
        title: t("index.escapeTitle"),
        text: t("index.escapeDesc"),
        photo: "https://live.staticflickr.com/65535/54642647178_2c2d211300_b.jpg"
    }
];
---

<Base title={t("index.title")}>
    <Hero />

    {
        news && (
            <section class="mx-auto -mt-10 max-w-3xl px-4 sm:-mt-16 sm:px-8" aria-labelledby="news-title">
                <div class="relative rounded-xl border border-grid bg-surface px-6 py-7 shadow-[0_18px_40px_-28px_rgb(15_23_42/0.45)] sm:px-10">
                    <span class="absolute inset-y-6 left-0 w-1 rounded-r bg-marker" aria-hidden="true" />
                    <h2 id="news-title" class="font-serif text-2xl font-bold sm:text-3xl">
                        <Untranslated missing={news.missing} message={t("index.noTranslation")}>
                            {news.title.value}
                        </Untranslated>
                    </h2>
                    {news.descriptionHtml && (
                        <div
                            class="prose prose-custom dark:prose-invert mt-3 max-w-none break-words sm:prose-lg"
                            set:html={news.descriptionHtml}
                        />
                    )}
                    {news.url && (
                        <a href={`/${news.url.replace(/^\/+/, "")}`} class="btn key mt-6">
                            {t("index.knowMore")}
                        </a>
                    )}
                </div>
            </section>
        )
    }

    <section class="mx-auto mt-20 grid max-w-6xl items-center gap-12 px-4 sm:mt-28 sm:px-8 md:grid-cols-[minmax(0,5fr)_minmax(0,7fr)]" aria-labelledby="magazine-title">
        <div class="flex justify-center md:justify-end md:pr-6">
            {
                latest ? (
                    <MagazineCover
                        cover={latest.cover}
                        title={`QED - ${latest.title.value}`}
                        href={href("issue", { issue: latest.url })}
                        width="min(62vw, 17rem)"

                    />
                ) : (
                    <img
                        class="aspect-video w-full rounded-2xl object-cover"
                        src="https://live.staticflickr.com/65535/54643332816_c4c3d5bbc3_b.jpg"
                        alt=""
                        loading="lazy"
                    />
                )
            }
        </div>
        <div class="max-w-xl">
            <h2 id="magazine-title" class="font-serif text-4xl font-bold text-ink sm:text-5xl">{t("index.magazineTitle")}</h2>
            <p class="mt-5 text-lg leading-relaxed text-graphite/90">{t("index.magazineDesc")}</p>
            <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
                <a href={href("magazine")} class="btn key">{t("index.readMagazine")}</a>
                {
                    latest && (
                        <a href={href("issue", { issue: latest.url })} class="btn-quiet">
                            {t("index.latestIssue")}: {latest.title.value}
                        </a>
                    )
                }
            </div>
        </div>
    </section>

    <section class="mx-auto mt-24 max-w-6xl px-4 sm:mt-32 sm:px-8" aria-labelledby="beyond-title">
        <h2 id="beyond-title" class="font-serif text-3xl font-bold sm:text-4xl">{t("index.beyondTitle")}</h2>
        <div class="mt-10 grid gap-x-10 gap-y-14 md:grid-cols-3">
            {
                activities.map((activity) => (
                    <article>
                        <img
                            class="aspect-[4/3] w-full rounded-lg bg-grid object-cover"
                            src={activity.photo}
                            alt=""
                            loading="lazy"
                            decoding="async"
                        />
                        <h3 class="mt-5 font-serif text-2xl font-bold">{activity.title}</h3>
                        <p class="mt-3 leading-relaxed text-graphite/85">{activity.text}</p>
                    </article>
                ))
            }
        </div>
        <a href={href("activities")} class="btn key mt-12">{t("index.seeActivities")}</a>
    </section>
</Base>
