---
// Home hero: the QED logo beside one engraved mathematical figure. Each visit starts on a
// random figure; clicking it shows the next one of the collection, and the caption names it.
import QedLogo from "./QedLogo.astro";
import Figure from "./Figure.astro";
import { usePage } from "../lib/page";

const { t } = usePage(Astro);
const COLLECTION = [
    "trefoil",
    "klein",
    "mobius",
    "torus",
    "enneper",
    "torusKnot",
    "seashell",
    "catenoid",
    "roman",
    "figureEight",
    "helicoid",
    "dini",
    "hyperboloid",
    "saddle",
    "sphere",
    "icosahedron",
    "dodecahedron",
    "octahedron",
    "cube",
    "tetrahedron"
];
const start = Math.floor(Math.random() * COLLECTION.length);
const ordered = [...COLLECTION.slice(start), ...COLLECTION.slice(0, start)];
const cycle = Object.fromEntries(ordered.map((key) => [key, t(`figures.${key}`)]));
const first = ordered[0];
---

<section class="hero graph-paper relative isolate overflow-hidden border-b border-grid" aria-labelledby="hero-title">
    <div
        class="mx-auto grid max-w-6xl items-center gap-4 px-6 pt-6 pb-20 sm:pt-10 sm:pb-28 md:grid-cols-[minmax(0,11fr)_minmax(0,9fr)] md:gap-10">
        <div class="order-2 flex flex-col items-center md:order-1 md:items-start">
            <h1 id="hero-title" class="w-[min(78vw,30rem)] text-graphite">
                <QedLogo class="hero-logo w-full" title="QED" />
            </h1>
            <p id="hero-subtitle" class="mt-6 text-center font-serif text-xl text-graphite italic sm:text-3xl md:text-left">
                {t("index.logoSubtitle")}
            </p>
        </div>

        <Figure
            class="order-1 md:order-2"
            shape={first}
            caption={cycle[first]}
            cycle={cycle}
            cycleLabel={t("index.figures.next")}
            figureClass="aspect-square w-[min(72vw,26rem)]"
            speed={0.35}>
            <span slot="hint" class="block font-sans text-xs not-italic opacity-80">{t("index.figures.hint")}</span>
        </Figure>
    </div>
</section>

<script is:inline>
    // First visit from outside the site: draw the logo in and fade the subtitle, as before.
    (() => {
        const internal = document.referrer && document.referrer.startsWith(location.origin);
        const nav = performance.getEntriesByType("navigation")[0];
        const reload = nav && nav.type === "reload";
        const reduce = matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (internal || reload || reduce) return;
        document.querySelector(".hero-logo")?.classList.add("qed-logo-draw");
        const subtitle = document.getElementById("hero-subtitle");
        if (subtitle) {
            subtitle.style.opacity = "0";
            subtitle.style.transition = "opacity 0.7s ease-in-out";
            setTimeout(() => (subtitle.style.opacity = "1"), 1000);
        }
    })();
</script>
