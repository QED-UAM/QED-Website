---
// ∎ — the end-of-proof mark (Halmos' tombstone) as a small cube. It drops into place once,
// when the reader reaches the end of an article. Static under prefers-reduced-motion.
interface Props {
    label: string;
    size?: string;
    class?: string;
    /** Visible text next to the cube, e.g. "Quod erat demonstrandum". */
    caption?: string;
    /** Explanation shown on hover/focus. */
    meaning?: string;
}

const { label, size = "1.6rem", class: className, caption, meaning } = Astro.props;
const tipId = `qed-tip-${Math.random().toString(36).slice(2, 8)}`;
---

{
    caption ? (
        <span class:list={["qed-end", className]} tabindex="0" aria-describedby={meaning ? tipId : undefined}>
            <span class="qed-end-text">{caption}</span>
            <span class="tombstone" style={`--cube: ${size};`} aria-hidden="true">
                <span class="tombstone-cube">
                    <span class="face front" />
                    <span class="face back" />
                    <span class="face right" />
                    <span class="face left" />
                    <span class="face top" />
                    <span class="face bottom" />
                </span>
            </span>
            {meaning && (
                <span class="qed-end-tip" role="tooltip" id={tipId}>
                    {meaning}
                </span>
            )}
        </span>
    ) : (
<span class:list={["tombstone", className]} style={`--cube: ${size};`} role="img" aria-label={label} title={label}>
    <span class="tombstone-cube">
        <span class="face front"></span>
        <span class="face back"></span>
        <span class="face right"></span>
        <span class="face left"></span>
        <span class="face top"></span>
        <span class="face bottom"></span>
    </span>
</span>
    )
}

<style is:global>
    .tombstone {
        display: inline-block;
        width: var(--cube);
        height: var(--cube);
        perspective: 600px;
        vertical-align: middle;
    }
    .tombstone-cube {
        position: relative;
        display: block;
        width: 100%;
        height: 100%;
        transform-style: preserve-3d;
        transform: rotateX(-8deg) rotateY(-18deg);
    }
    .tombstone:not([data-settled]) .tombstone-cube {
        opacity: 0;
    }
    .tombstone[data-settled] .tombstone-cube {
        animation: var(--animate-settle);
    }
    .tombstone .face {
        position: absolute;
        inset: 0;
        background: var(--qed-text);
    }
    .tombstone .front {
        transform: translateZ(calc(var(--cube) / 2));
    }
    .tombstone .back {
        transform: rotateY(180deg) translateZ(calc(var(--cube) / 2));
    }
    .tombstone .right {
        transform: rotateY(90deg) translateZ(calc(var(--cube) / 2));
        filter: brightness(1.9);
    }
    .tombstone .left {
        transform: rotateY(-90deg) translateZ(calc(var(--cube) / 2));
        filter: brightness(1.9);
    }
    .tombstone .top {
        transform: rotateX(90deg) translateZ(calc(var(--cube) / 2));
        background: var(--color-marker);
    }
    .tombstone .bottom {
        transform: rotateX(-90deg) translateZ(calc(var(--cube) / 2));
    }
    .dark .tombstone .right,
    .dark .tombstone .left {
        filter: brightness(0.7);
    }
    @media (prefers-reduced-motion: reduce) {
        .tombstone:not([data-settled]) .tombstone-cube {
            opacity: 1;
        }
    }

    /* End-of-proof line: "Quod erat demonstrandum ∎" with its meaning on hover/focus. */
    .qed-end {
        position: relative;
        display: inline-flex;
        align-items: center;
        gap: 0.75rem;
        cursor: help;
        border-radius: 0.4rem;
    }
    .qed-end-text {
        font-family: var(--font-serif);
        font-style: italic;
        font-size: 1.05rem;
        color: var(--qed-muted);
        text-decoration: underline dotted color-mix(in srgb, var(--qed-muted) 60%, transparent);
        text-underline-offset: 0.25em;
    }
    .qed-end-tip {
        position: absolute;
        right: 0;
        bottom: calc(100% + 0.6rem);
        width: max-content;
        max-width: min(22rem, 80vw);
        padding: 0.55rem 0.8rem;
        border-radius: 0.5rem;
        background: var(--qed-text);
        color: var(--qed-paper);
        font-family: var(--font-sans);
        font-size: 0.85rem;
        font-style: normal;
        line-height: 1.4;
        text-align: left;
        box-shadow: 0 10px 24px -12px rgb(0 0 0 / 0.5);
        opacity: 0;
        transform: translateY(4px);
        pointer-events: none;
        transition:
            opacity 0.15s ease,
            transform 0.15s ease;
    }
    .qed-end:hover .qed-end-tip,
    .qed-end:focus-visible .qed-end-tip {
        opacity: 1;
        transform: translateY(0);
    }
</style>

<script>
    const observer = new IntersectionObserver(
        (entries) => {
            for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                (entry.target as HTMLElement).dataset.settled = "";
                observer.unobserve(entry.target);
            }
        },
        { threshold: 1 }
    );
    document.querySelectorAll(".tombstone").forEach((element) => observer.observe(element));
</script>
