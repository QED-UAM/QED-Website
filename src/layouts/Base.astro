---
import "../styles/global.css";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { usePage } from "../lib/page";
import { supportedLocales } from "../lib/i18n";
import { localizedPathname } from "../lib/i18n/routes";
import { DEFAULT_LOCALE } from "../lib/config";

interface Props {
    /** Page title, already translated. Rendered as-is (never looked up again). */
    title: string;
    description?: string;
    image?: string;
    type?: "website" | "article" | "profile";
    jsonLd?: Record<string, unknown>;
    noindex?: boolean;
    /** Hide the footer (admin, error pages). */
    bare?: boolean;
}

const { locale, t, origin } = usePage(Astro);
const {
    title,
    description = t("meta.description"),
    image = `${origin}/images/favicon.png`,
    type = "website",
    jsonLd,
    noindex = false,
    bare = false
} = Astro.props;

const pageTitle = `${title} - QED`;
const path = Astro.locals.originalPath;
const canonical = origin + localizedPathname(path, locale);
const alternates = supportedLocales().map((language) => ({
    language,
    url: `${origin}${localizedPathname(path, language)}?lang=${language}`
}));
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, "\\u003c") : undefined;
---

<!doctype html>
<html lang={locale}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{pageTitle}</title>
        <meta name="description" content={description} />
        <meta name="theme-color" content="#f2a14d" />
        <link rel="icon" type="image/png" href="/images/favicon.png" />
        <link rel="canonical" href={canonical} />
        {alternates.map((alt) => <link rel="alternate" hreflang={alt.language} href={alt.url} />)}
        <link
            rel="alternate"
            hreflang="x-default"
            href={`${origin}${localizedPathname(path, DEFAULT_LOCALE)}`}
        />
        {noindex && <meta name="robots" content="noindex" />}

        <meta property="og:type" content={type} />
        <meta property="og:site_name" content="QED" />
        <meta property="og:url" content={canonical} />
        <meta property="og:title" content={pageTitle} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={image} />
        <meta property="og:locale" content={locale === "es" ? "es_ES" : "en_GB"} />
        <meta name="twitter:card" content="summary" />
        <meta name="twitter:title" content={pageTitle} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={image} />

        <link rel="preload" href="/fonts/cmu-serif-700-roman.woff2" as="font" type="font/woff2" crossorigin />
        <script is:inline src="/js/theme.js"></script>
        {jsonLdText && <script is:inline type="application/ld+json" set:html={jsonLdText} />}
        <slot name="head" />
    </head>
    <body class="flex min-h-screen flex-col bg-paper text-graphite antialiased">
        <a
            href="#main"
            class="sr-only z-50 rounded-md bg-surface px-4 py-2 font-semibold focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
            >{t("nav.skipToContent")}</a
        >
        <div id="scroll-percentage" aria-hidden="true"></div>
        <slot name="before-nav" />
        <Nav />
        <main id="main" class="flex-1">
            <slot />
        </main>
        {!bare && <Footer />}

        <script>
            import "../scripts/site";
        </script>
    </body>
</html>
